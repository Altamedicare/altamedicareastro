---
import MainLayout from './MainLayout.astro';
import AiSummary from '../components/AiSummary.astro';
import FeatureArticle from '../components/blog/FeatureArticle.astro';
import { TOOLS, CATEGORIES, COMPARE_PLANS_URL, CONTACT_URL, PHONE_TEL, PHONE_DISPLAY } from '../consts';

interface RelatedPost { slug: string; title: string; description: string; category: string; }
interface NavPost { slug: string; title: string; }

interface Props {
  slug: string;
  title: string;
  description: string;
  category: keyof typeof CATEGORIES;
  publishDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  image?: string;
  faqs: { question: string; answer: string }[];
  relatedTools: string[];
  readingTime: number;
  related: RelatedPost[];
  prev?: NavPost;
  next?: NavPost;
  /** Opt-in visual layout (frontmatter `presentation`). */
  presentation?: 'feature';
  /** Raw Markdown body — read only by the feature layout. */
  body?: string;
}

const {
  slug, title, description, category, publishDate, updatedDate,
  author, tags, image, faqs, relatedTools, readingTime, related, prev, next,
  presentation, body = '',
} = Astro.props;
const feature = presentation === 'feature';
// Feature hero: gold accent on the title's last word, and up to three
// indicators taken from the bold terms of the body's first bulleted list.
const tw = title.split(' ');
const titleLead = tw.length > 1 ? tw.slice(0, -1).join(' ') + ' ' : '';
const titleTail = tw.length > 1 ? tw[tw.length - 1] : title;
const firstList = (body.match(/(?:^[-*] .*\n?)+/m) || [''])[0];
const heroTerms = [...firstList.matchAll(/\*\*(.+?)\*\*/g)]
  .map((m) => m[1].charAt(0).toUpperCase() + m[1].slice(1)).slice(0, 3);
const hsvg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const heroIcons = [
  hsvg('<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>'),
  hsvg('<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>'),
  hsvg('<path d="M3 9l1.5-5h15L21 9M3 9h18v11a1 1 0 01-1 1H4a1 1 0 01-1-1zM3 9a3 3 0 006 0 3 3 0 006 0 3 3 0 006 0"/><path d="M10 21v-6h4v6"/>'),
];
const arrowSvg = hsvg('<path d="M5 12h14M13 6l6 6-6 6"/>');
const phoneSvg = hsvg('<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0122 16.92z"/>');


const canonical = `/blog/${slug}`;
const cat = CATEGORIES[category];
const SITE = 'https://altamedicare.com';
const ogImage = image || '/images/og-image.png';

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
const lastUpdated = updatedDate || publishDate;

// Only tool keys that exist in the registry, in frontmatter order.
const toolCards = relatedTools
  .filter((k): k is keyof typeof TOOLS => k in TOOLS)
  .map((k) => TOOLS[k]);

// ── Structured data ──────────────────────────────────────────────
// Rich Person author (EEAT), matching NewsArticle.astro. Single-author site →
// keyed to the About page anchor so blog and news resolve to one Bret entity
// instead of two unrelated bare Persons. worksFor points at the canonical
// organization by @id rather than restating it.
const authorLd = {
  '@type': 'Person',
  '@id': `${SITE}/about.html#bret-swope`,
  name: author,
  jobTitle: 'Licensed Utah Medicare Agent',
  url: `${SITE}/about`,
  worksFor: { '@id': `${SITE}/#organization` },
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: iso(publishDate),
  dateModified: iso(lastUpdated),
  author: authorLd,
  // Reference, not a copy. MainLayout emits the InsuranceAgency node on every
  // page, so the target is present in this page's graph. Restating it here
  // minted a second, anonymous Organization and carried a logo URL
  // (/images/favicon.svg) that does not exist — the favicon lives at the site
  // root. Both defects disappear with the reference.
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE}${canonical}` },
  image: `${SITE}${ogImage}`,
  keywords: tags.join(', '),
  articleSection: cat.title,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog` },
    { '@type': 'ListItem', position: 3, name: cat.title, item: `${SITE}/blog/category/${category}` },
    { '@type': 'ListItem', position: 4, name: title, item: `${SITE}${canonical}` },
  ],
};

const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
---

<MainLayout title={`${title} | AltaMedicare`} description={description} canonical={canonical} ogImage={ogImage} pageType="Blog">
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
    {faqLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <article class={feature ? 'blog-post blog-post--feature' : 'blog-post'}>
    {feature && (
    <header class="post-header post-header--feature">
      <div class="container">
        <div class="fx-hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a> &nbsp;&rsaquo;&nbsp;
            <a href="/blog">Blog</a> &nbsp;&rsaquo;&nbsp;
            <a href={`/blog/category/${category}`}>{cat.title}</a>
          </nav>
          <span class="post-cat-tag"><i class={`fa-solid ${cat.icon}`}></i> {cat.title}</span>
          <h1>{titleLead}<span class="fx-accent">{titleTail}</span></h1>
          <AiSummary />
          <p class="lede">{description}</p>
          <div class="post-meta">
            <span><i class="fa-solid fa-user-pen"></i> {author}</span>
            <span><i class="fa-solid fa-clock"></i> {readingTime} min read</span>
            <span><i class="fa-solid fa-rotate"></i> Updated {fmt(lastUpdated)}</span>
          </div>
          {heroTerms.length > 0 && (
            <ul class="fx-hero-terms">
              {heroTerms.map((t, i) => <li><span set:html={heroIcons[i % heroIcons.length]} />{t}</li>)}
            </ul>
          )}
        </div>
      </div>
    </header>
    )}
    {!feature && (
    <header class="post-header">
      <div class="container content-narrow">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> &nbsp;&rsaquo;&nbsp;
          <a href="/blog">Blog</a> &nbsp;&rsaquo;&nbsp;
          <a href={`/blog/category/${category}`}>{cat.title}</a>
        </nav>
        <span class="post-cat-tag"><i class={`fa-solid ${cat.icon}`}></i> {cat.title}</span>
        <h1>{title}</h1>
        <AiSummary />
        <p class="lede">{description}</p>
        <div class="post-meta">
          <span><i class="fa-solid fa-user-pen"></i> {author}</span>
          <span><i class="fa-solid fa-clock"></i> {readingTime} min read</span>
          <span><i class="fa-solid fa-rotate"></i> Updated {fmt(lastUpdated)}</span>
        </div>
      </div>
    </header>
    )}

    <div class="section-white">
      <div class={feature ? 'container post-body fx-body' : 'container content-narrow post-body'}>
        {feature ? <FeatureArticle body={body} /> : <slot />}

        {category === 'drug-coverage' && (
          <p class="post-disclaimer">
            <strong>Medical &amp; coverage disclaimer:</strong> This article is general education &mdash; not
            medical advice or a guarantee of coverage. Whether a specific drug is covered, and what you&rsquo;ll
            pay, depends on your individual Part&nbsp;D or Medicare Advantage plan, its formulary, and the plan
            year, and can change. Always confirm with your plan or a licensed agent, and talk to your doctor
            about your treatment.
          </p>
        )}

        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((t) => <span class="post-tag">{t}</span>)}
          </div>
        )}
      </div>
    </div>

    {faqs.length > 0 && (
      <section class="section-tinted">
        <div class="container content-narrow">
          <h2 class="faq-title">Frequently Asked Questions</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {feature && toolCards.length > 0 && (
      <section class="fx-tools">
        <div class="container">
          <div class="section-header">
            <span class="eyebrow">Free tools</span>
            <h2>Related Calculators</h2>
            <p>Put these numbers to work for your own situation.</p>
          </div>
          <div class="fx-tool-grid">
            {toolCards.map((t) => (
              <a href={t.href} class="fx-tool">
                <span class="fx-tool-icon"><i class={`fa-solid ${t.icon}`} aria-hidden="true"></i></span>
                <span class="fx-tool-text"><strong>{t.title}</strong><span>{t.desc}</span></span>
                <span class="fx-tool-btn">Open tool<span set:html={arrowSvg} /></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {!feature && toolCards.length > 0 && (
      <section class="section-white">
        <div class="container">
          <div class="section-header">
            <span class="eyebrow">Free tools</span>
            <h2>Related Calculators</h2>
            <p>Put these numbers to work for your own situation.</p>
          </div>
          <div class="card-grid">
            {toolCards.map((t) => (
              <a href={t.href} class="card" style="text-decoration:none;">
                <div class="card-icon"><i class={`fa-solid ${t.icon}`} style="font-size:1.6rem"></i></div>
                <h3>{t.title}</h3>
                <p>{t.desc}</p>
                <span class="card-link">Open tool</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {feature && (
    <section class="ma-cta fx-cta">
      <div class="container">
        <div>
          <span class="ma-eyebrow ma-eyebrow--light">Free consultation</span>
          <h2>Want a real person to walk through this with you?</h2>
          <p>Bret Swope is a licensed Utah Medicare agent. No bots, no pressure &mdash; just clear answers.</p>
        </div>
        <div class="ma-cta-actions">
          <a href={CONTACT_URL} class="ma-btn-gold">Talk to Bret<span set:html={arrowSvg} /></a>
          <a href={PHONE_TEL} class="ma-cta-phone"><span set:html={phoneSvg} />Call {PHONE_DISPLAY}</a>
          <a href={COMPARE_PLANS_URL} class="ma-cta-compare" target="_blank" rel="noopener">Compare Plans Online<span set:html={arrowSvg} /></a>
        </div>
      </div>
    </section>
    )}

    {!feature && (
    <section class="post-help section-tinted">
      <div class="container content-narrow">
        <div class="callout">
          <strong>Want a real person to walk through this with you?</strong>
          <p style="margin:8px 0 14px;">Bret Swope is a licensed Utah Medicare agent. No bots, no pressure &mdash; just clear answers.</p>
          <div class="cta-buttons">
            <a href={CONTACT_URL} class="btn btn-primary">Talk to Bret</a>
            <a href={COMPARE_PLANS_URL} class="btn btn-outline" target="_blank" rel="noopener">Compare Plans Online</a>
            <a href={PHONE_TEL} class="btn btn-outline">Call {PHONE_DISPLAY}</a>
          </div>
        </div>
      </div>
    </section>
    )}

    {related.length > 0 && (
      <section class="section-white">
        <div class="container">
          <div class="section-header">
            <span class="eyebrow">Keep reading</span>
            <h2>Related Articles</h2>
          </div>
          <div class="card-grid">
            {related.map((r) => (
              <a href={`/blog/${r.slug}`} class="card" style="text-decoration:none;">
                <span class="card-eyebrow">{CATEGORIES[r.category as keyof typeof CATEGORIES]?.title}</span>
                <h3>{r.title}</h3>
                <p>{r.description}</p>
                <span class="card-link">Read article</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {(prev || next) && (
      <nav class="post-nav" aria-label="More articles">
        <div class="container content-narrow">
          <div class="post-nav-grid">
            {prev ? (
              <a class="post-nav-link prev" href={`/blog/${prev.slug}`}>
                <span class="pn-dir"><i class="fa-solid fa-arrow-left"></i> Previous</span>
                <span class="pn-title">{prev.title}</span>
              </a>
            ) : <span></span>}
            {next ? (
              <a class="post-nav-link next" href={`/blog/${next.slug}`}>
                <span class="pn-dir">Next <i class="fa-solid fa-arrow-right"></i></span>
                <span class="pn-title">{next.title}</span>
              </a>
            ) : <span></span>}
          </div>
        </div>
      </nav>
    )}
  </article>
</MainLayout>
