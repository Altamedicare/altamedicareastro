---
// src/components/blog/FeatureArticle.astro — the opt-in "feature" presentation
// for a blog post (frontmatter `presentation: "feature"`).
//
// The post's Markdown stays the single source of truth: this component splits
// the raw body on its `##` sections and renders each fragment with Astro's own
// Markdown processor, then lays the pieces out as cards, steps and panels.
// No sentence is copied into this file — edit the .md, and this page updates.
//
// Layout rules (generic, so another post can opt in later):
//   • text before the first `##`        → lead paragraph
//   • section with a bulleted list      → intro + compact cards (one per item)
//   • section with a numbered list      → numbered steps
//   • section whose heading has a `$`   → highlighted figure panel
//   • any other section                 → alternating editorial panels
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

interface Props { body: string }
const { body } = Astro.props;

const md = await createMarkdownProcessor();
const html = async (src: string) => (await md.render(src.trim())).code;
const inline = async (src: string) => (await html(src)).replace(/^<p>([\s\S]*)<\/p>\s*$/, '$1');

type Block = { kind: 'p'; md: string } | { kind: 'ul' | 'ol'; items: string[] };
function blocks(src: string): Block[] {
  const out: Block[] = [];
  for (const chunk of src.trim().split(/\n\s*\n/)) {
    const lines = chunk.split('\n');
    if (lines.every((l) => /^\s*[-*]\s+/.test(l))) out.push({ kind: 'ul', items: lines.map((l) => l.replace(/^\s*[-*]\s+/, '')) });
    else if (lines.every((l) => /^\s*\d+\.\s+/.test(l))) out.push({ kind: 'ol', items: lines.map((l) => l.replace(/^\s*\d+\.\s+/, '')) });
    else out.push({ kind: 'p', md: chunk });
  }
  return out;
}

// "**Social Security.** This is…" → title + detail; "Your monthly **premium**" → title from the bold term.
const itemParts = (item: string) => {
  const lead = item.match(/^\*\*(.+?)\*\*\s*(.*)$/s);
  if (lead) return { title: lead[1].replace(/[.:]$/, ''), detail: lead[2].replace(/^[—–-]\s*/, '') };
  const bold = item.match(/\*\*(.+?)\*\*/);
  const t = bold ? bold[1] : item;
  return { title: t.charAt(0).toUpperCase() + t.slice(1), detail: item };
};

const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const I = {
  coins: svg('<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>'),
  doc: svg('<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>'),
  store: svg('<path d="M3 9l1.5-5h15L21 9M3 9h18v11a1 1 0 01-1 1H4a1 1 0 01-1-1zM3 9a3 3 0 006 0 3 3 0 006 0 3 3 0 006 0"/><path d="M10 21v-6h4v6"/>'),
  people: svg('<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>'),
  shield: svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>'),
  bank: svg('<path d="M3 21h18M4 18h16M6 18v-7M10 18v-7M14 18v-7M18 18v-7M12 3l9 5H3z"/>'),
  laptop: svg('<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/>'),
  hand: svg('<path d="M11 14h2a2 2 0 000-4h-3c-.6 0-1.1.2-1.4.6L3 16"/><path d="M7 20l1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 00-2.75-2.91l-4.2 3.9"/><path d="M2 15l6 6"/>'),
  pill: svg('<path d="M10.5 20.5l10-10a4.95 4.95 0 10-7-7l-10 10a4.95 4.95 0 107 7z"/><path d="M8.5 8.5l7 7"/>'),
  question: svg('<circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 015.8 1c0 2-3 3-3 3M12 17h.01"/>'),
  info: svg('<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>'),
};
const iconFor = (text: string) => {
  const t = text.toLowerCase();
  if (/premium/.test(t)) return I.coins;
  if (/deductible/.test(t)) return I.doc;
  if (/copay|pharmac/.test(t)) return I.store;
  if (/social security/.test(t)) return I.bank;
  if (/medicaid/.test(t)) return /appl|utah/.test(t) ? I.laptop : I.people;
  if (/ssi|supplemental security/.test(t)) return I.shield;
  if (/savings program/.test(t)) return I.doc;
  if (/help|agent|hand/.test(t)) return I.hand;
  return I.pill;
};

// ---- parse ----
const [leadMd, ...rawSections] = body.split(/^##\s+/m);
const lead = await html(leadMd);
const sections = await Promise.all(rawSections.map(async (raw, idx) => {
  const nl = raw.indexOf('\n');
  const heading = raw.slice(0, nl).trim();
  const bl = blocks(raw.slice(nl + 1));
  const list = bl.find((b) => b.kind !== 'p') as Extract<Block, { items: string[] }> | undefined;
  const listAt = list ? bl.indexOf(list) : -1;
  const before = await Promise.all(bl.slice(0, listAt === -1 ? bl.length : listAt).filter((b) => b.kind === 'p').map((b) => html((b as { md: string }).md)));
  const after = listAt === -1 ? [] : await Promise.all(bl.slice(listAt + 1).filter((b) => b.kind === 'p').map((b) => html((b as { md: string }).md)));
  const items = list ? await Promise.all(list.items.map(async (it) => {
    const p = itemParts(it);
    return { title: await inline(p.title), detail: await inline(p.detail), icon: iconFor(it) };
  })) : [];
  const kind = list?.kind === 'ul' ? 'cards' : list?.kind === 'ol' ? 'steps' : /\$/.test(heading) ? 'figure' : 'panel';
  return { heading: await inline(heading), id: heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''), kind, before, items, after, idx };
}));
// The $-figure in a heading ("The $2,000 cap…") is shown large — taken from the text, never typed here.
const figureOf = (h: string) => (h.match(/\$[\d,]+/) || [''])[0];
let panelNo = 0;
---

<div class="fx-article">
  <div class="fx-lead" set:html={lead} />

  {sections.map((s) => {
    if (s.kind === 'cards') return (
      <section class="fx-section fx-cards-section" id={s.id}>
        <h2 set:html={s.heading} />
        {s.before.map((p) => <div class="fx-text" set:html={p} />)}
        <ul class={`fx-cards fx-cards--${Math.min(s.items.length, 4)}`}>
          {s.items.map((it) => (
            <li class="fx-card">
              <span class="fx-card-icon" set:html={it.icon} />
              <div><h3 set:html={it.title} /><p set:html={it.detail} /></div>
            </li>
          ))}
        </ul>
        {s.after.map((p) => <div class="fx-text fx-after" set:html={p} />)}
      </section>
    );
    if (s.kind === 'steps') return (
      <section class="fx-section fx-steps-section" id={s.id}>
        <h2 set:html={s.heading} />
        {s.before.map((p) => <div class="fx-text" set:html={p} />)}
        <ol class="fx-steps">
          {s.items.map((it, i) => (
            <li class="fx-step">
              <span class="fx-step-num">{i + 1}</span>
              <span class="fx-step-icon" set:html={it.icon} />
              <h3 set:html={it.title} />
              <p set:html={it.detail} />
            </li>
          ))}
        </ol>
        {s.after.map((p, i) => <div class={`fx-text ${i === s.after.length - 1 ? 'fx-help' : 'fx-after'}`} set:html={p} />)}
      </section>
    );
    if (s.kind === 'figure') return (
      <section class="fx-section fx-figure-section" id={s.id}>
        <div class="fx-figure-card">
          <span class="fx-figure-icon" set:html={I.coins} />
          <span class="fx-figure-num">{figureOf(s.heading)}</span>
          <h2 set:html={s.heading} />
        </div>
        <div>{[...s.before, ...s.after].map((p) => <div class="fx-text" set:html={p} />)}</div>
      </section>
    );
    const alt = panelNo++ % 2 === 1;
    return (
      <section class={`fx-section fx-panel${alt ? ' fx-panel--alt' : ''}`} id={s.id}>
        <div class="fx-panel-mark" aria-hidden="true"><span set:html={alt ? I.pill : I.question} /></div>
        <div>
          <h2 set:html={s.heading} />
          {[...s.before, ...s.after].map((p) => <div class="fx-text" set:html={p} />)}
        </div>
      </section>
    );
  })}
</div>
