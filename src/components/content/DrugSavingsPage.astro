---
// src/components/content/DrugSavingsPage.astro — THE shared template.
// Copy lives in src/i18n/content/{locale}/drug-savings.json. sms:/mailto:
// prefilled bodies stay here (protocol-href boundary — English messages to Bret).
import MainLayout from '../../layouts/MainLayout.astro';
import AiSummary from '../AiSummary.astro';
import { DEFAULT_LOCALE, getLangFromUrl, getLocaleMeta } from '../../i18n/locales';
import { getPageContent, hreflangAlternates, interp, localizeHref } from '../../i18n/content';
import { PHONE_DISPLAY } from '../../consts';

interface DrugSavingsContent {
  page: { title: string; description: string };
  breadcrumbHtml: string;
  header: { h1: string; ledeHtml: string };
  why: { h2: string; intro: string; itemsHtml: string[]; outroHtml: string };
  review: {
    eyebrow: string; h2: string; introHtml: string;
    textAction: { strong: string; spanHtml: string; label: string };
    emailAction: { strong: string; span: string; label: string };
    noteHtml: string;
  };
  cta: { h2: string; textHtml: string; scheduleLabel: string; callLabel: string };
}

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<DrugSavingsContent>('drug-savings', lang);
const vars = { phone: PHONE_DISPLAY };
const canonical = lang === DEFAULT_LOCALE ? '/drug-savings.html' : `/${lang}/drug-savings`;
const alternates = hreflangAlternates('drug-savings');
---

<MainLayout
  title={c.page.title}
  description={c.page.description}
  canonical={canonical}
>
  <Fragment slot="head">
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {lang !== DEFAULT_LOCALE && <meta property="og:locale" content={getLocaleMeta(lang).ogLocale} />}
  </Fragment>

<section class="page-header">
  <div class="container">
    <div class="breadcrumb" set:html={c.breadcrumbHtml}></div>
    <h1>{c.header.h1}</h1>
    <AiSummary />
    <p class="lede" set:html={c.header.ledeHtml}></p>
  </div>
</section>

<section class="section-white">
  <div class="container content-narrow">
    <h2>{c.why.h2}</h2>
    <p>{c.why.intro}</p>
    <ul>
      {c.why.itemsHtml.map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={c.why.outroHtml}></p>
  </div>
</section>

<section class="prescription-section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{c.review.eyebrow}</span>
      <h2>{c.review.h2}</h2>
      <p set:html={c.review.introHtml}></p>
    </div>

    <div class="form-card contact-actions">
      <div class="contact-action">
        <div class="icon-circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        </div>
        <div class="contact-action-text">
          <strong>{c.review.textAction.strong}</strong>
          <span set:html={c.review.textAction.spanHtml}></span>
        </div>
        <a href="sms:14352925548?body=Hi%20Bret%2C%20can%20you%20review%20my%20prescription%20costs%3F%20My%20medications%20are%3A%0D%0A" class="btn btn-primary btn-lg">{c.review.textAction.label}</a>
      </div>

      <div class="contact-action">
        <div class="icon-circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
        </div>
        <div class="contact-action-text">
          <strong>{c.review.emailAction.strong}</strong>
          <span>{c.review.emailAction.span}</span>
        </div>
        <a href="mailto:bret@altamedicare.com?subject=Free%20Prescription%20Review&body=Name%3A%0D%0APhone%3A%0D%0AZIP%3A%0D%0APreferred%20Pharmacy%3A%0D%0A%0D%0AMedications%20(one%20per%20line%2C%20with%20dose%20if%20known)%3A%0D%0A" class="btn btn-outline btn-lg">{c.review.emailAction.label}</a>
      </div>

      <p style="font-size:0.9rem; color:var(--text-muted); text-align:center; margin:18px 0 0;" set:html={c.review.noteHtml}></p>
    </div>
  </div>
</section>

<section class="final-cta">
  <div class="container">
    <h2>{c.cta.h2}</h2>
    <p set:html={c.cta.textHtml}></p>
    <div class="cta-buttons">
      <a href={localizeHref('/contact', lang)} class="btn btn-primary btn-lg">{c.cta.scheduleLabel}</a>
      <a href="tel:4352925548" class="btn btn-outline btn-lg">{interp(c.cta.callLabel, vars)}</a>
    </div>
  </div>
</section>

</MainLayout>
