---
// src/components/content/MedicareBasicsPage.astro — THE shared template.
// Copy lives in src/i18n/content/{locale}/medicare-basics.json.
import MainLayout from '../../layouts/MainLayout.astro';
import AiSummary from '../AiSummary.astro';
import HelpfulTools from '../HelpfulTools.astro';
import { DEFAULT_LOCALE, getLangFromUrl, getLocaleMeta } from '../../i18n/locales';
import { getPageContent, hreflangAlternates, interp, localizeHref } from '../../i18n/content';
import { PHONE_DISPLAY } from '../../consts';

interface Block { h3Html: string; textHtml: string }
interface Link { __href: string; label: string }
interface MedicareBasicsContent {
  page: { title: string; description: string };
  breadcrumbHtml: string;
  header: { h1: string; lede: string; features: { strong: string; span: string }[] };
  parts: { eyebrow: string; h2: string; introHtml: string; blocks: Block[]; links: (Link | null)[] };
  enrollment: { eyebrow: string; h2: string; blocks: Block[] };
  callout: { heading: string; textHtml: string };
  comparison: { eyebrow: string; h2: string; intro: string; itemsHtml: string[]; outroHtml: string; links: Link[] };
  cta: { eyebrow: string; h2Html: string; textHtml: string; scheduleLabel: string; callLabel: string };
}

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<MedicareBasicsContent>('medicare-basics', lang);
const vars = { phone: PHONE_DISPLAY };
const canonical = lang === DEFAULT_LOCALE ? '/medicare-basics' : `/${lang}/medicare-basics`;
const alternates = hreflangAlternates('medicare-basics');
const href = (h: string) => localizeHref(h, lang);

// Presentation-only art (icons/letters); copy stays in the JSON.
const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const featureIcons = [
  svg('<path d="M2 4h7a3 3 0 013 3v13a2 2 0 00-2-2H2z"/><path d="M22 4h-7a3 3 0 00-3 3v13a2 2 0 012-2h8z"/>'),
  svg('<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>'),
  svg('<circle cx="12" cy="12" r="10"/><path d="M16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36z"/>'),
];
const partLetters = ['A', 'B', 'C', 'D'];
const partIcons = [
  svg('<path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M12 9v6M9 12h6"/>'),
  svg('<path d="M4.8 2.3A.3.3 0 105 2H4a2 2 0 00-2 2v5a6 6 0 006 6 6 6 0 006-6V4a2 2 0 00-2-2h-1a.2.2 0 10.3.3"/><path d="M8 15v1a6 6 0 006 6 6 6 0 006-6v-4"/><circle cx="20" cy="10" r="2"/>'),
  svg('<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10M7 13h10M7 17h6"/>'),
  svg('<path d="M10.5 20.5l10-10a4.95 4.95 0 10-7-7l-10 10a4.95 4.95 0 107 7z"/><path d="M8.5 8.5l7 7"/>'),
];
const enrollIcons = [
  svg('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/>'),
  svg('<path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>'),
  svg('<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/>'),
  svg('<path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/>'),
];
const shieldIcon = svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>');
const phoneIcon = svg('<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0122 16.92z"/>');
const arrow = svg('<path d="M5 12h14M13 6l6 6-6 6"/>');
---

<MainLayout
  title={c.page.title}
  description={c.page.description}
  canonical={canonical}
>
  <Fragment slot="head">
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {lang !== DEFAULT_LOCALE && <meta property="og:locale" content={getLocaleMeta(lang).ogLocale} />}
  </Fragment>

<section class="page-header page-header--basics">
  <div class="container">
    <!-- Soft white "cloud" behind the copy keeps it readable without darkening the photo. -->
    <div class="basics-hero-copy">
      <div class="breadcrumb" set:html={c.breadcrumbHtml}></div>
      <h1>{c.header.h1}</h1>
      <AiSummary />
      <p class="lede">{c.header.lede}</p>
      <ul class="basics-features">
        {c.header.features.map((f, i) => (
          <li>
            <span class="basics-feature-icon" set:html={featureIcons[i % featureIcons.length]} />
            <span><strong>{f.strong}</strong><span>{f.span}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="basics-section basics-parts">
  <div class="container">
    <div class="basics-head">
      <span class="basics-eyebrow">{c.parts.eyebrow}</span>
      <h2>{c.parts.h2}</h2>
      <p set:html={c.parts.introHtml}></p>
    </div>
    <div class="basics-parts-grid">
      {c.parts.blocks.map((b, i) => (
        <article class="basics-part">
          <div class="basics-part-art" set:html={partIcons[i % partIcons.length]} />
          <span class="basics-part-letter" aria-hidden="true">{partLetters[i]}</span>
          <h3 set:html={b.h3Html} />
          <p set:html={b.textHtml} />
          {c.parts.links[i] && (
            <a class="basics-link" href={href(c.parts.links[i]!.__href)}>{c.parts.links[i]!.label}<span set:html={arrow} /></a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<section class="basics-section basics-enroll">
  <div class="container">
    <div class="basics-head">
      <span class="basics-eyebrow">{c.enrollment.eyebrow}</span>
      <h2>{c.enrollment.h2}</h2>
    </div>
    <div class="basics-enroll-grid">
      <ul class="basics-enroll-list">
        {c.enrollment.blocks.map((b, i) => (
          <li>
            <span class="basics-enroll-icon" set:html={enrollIcons[i % enrollIcons.length]} />
            <div>
              <h3 set:html={b.h3Html} />
              <p set:html={b.textHtml} />
            </div>
          </li>
        ))}
      </ul>
      <aside class="basics-penalty">
        <div class="basics-penalty-art" aria-hidden="true">
          <span class="basics-penalty-cal" set:html={enrollIcons[0]} />
        </div>
        <div class="basics-penalty-body">
          <span class="basics-penalty-icon" aria-hidden="true">!</span>
          <div>
            <strong>{c.callout.heading}</strong>
            <p set:html={c.callout.textHtml}></p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="basics-section basics-compare">
  <div class="container">
    <div class="basics-head">
      <span class="basics-eyebrow">{c.comparison.eyebrow}</span>
      <h2>{c.comparison.h2}</h2>
      <p>{c.comparison.intro}</p>
    </div>
    <div class="basics-compare-grid">
      {c.comparison.itemsHtml.map((item, i) => (
        <div class={`basics-option basics-option--${i === 0 ? 'ma' : 'ms'}`}>
          <span class="basics-option-icon" set:html={i === 0 ? featureIcons[1] : shieldIcon} />
          <p set:html={item} />
          {c.comparison.links[i] && (
            <a class="basics-option-btn" href={href(c.comparison.links[i].__href)}>{c.comparison.links[i].label}<span set:html={arrow} /></a>
          )}
        </div>
      ))}
    </div>
    <p class="basics-compare-outro" set:html={c.comparison.outroHtml}></p>
  </div>
</section>

<section class="basics-cta">
  <div class="container">
    <div>
      <span class="basics-eyebrow">{c.cta.eyebrow}</span>
      <h2 set:html={c.cta.h2Html}></h2>
      <p set:html={c.cta.textHtml}></p>
    </div>
    <div class="basics-cta-actions">
      <a href={href('contact.html')} class="basics-cta-btn">{c.cta.scheduleLabel}<span set:html={arrow} /></a>
      <a href="tel:4352925548" class="basics-cta-phone"><span set:html={phoneIcon} />{interp(c.cta.callLabel, vars)}</a>
    </div>
  </div>
</section>

<div class="basics-tools">
<HelpfulTools />
</div>

</MainLayout>
