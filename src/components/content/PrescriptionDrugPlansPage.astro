---
// src/components/content/PrescriptionDrugPlansPage.astro — THE shared template.
// Copy lives in src/i18n/content/{locale}/prescription-drug-plans.json.
// CMS annual figures interpolate from src/data/figures.ts (§6.8) — the
// January figures update flows to both languages from one data edit.
import MainLayout from '../../layouts/MainLayout.astro';
import AiSummary from '../AiSummary.astro';
import HelpfulTools from '../HelpfulTools.astro';
import { DEFAULT_LOCALE, getLangFromUrl, getLocaleMeta } from '../../i18n/locales';
import { getPageContent, hreflangAlternates, interp, localizeHref } from '../../i18n/content';
import { COMPARE_PLANS_URL, PHONE_DISPLAY } from '../../consts';
import { CURRENT } from '../../data/figures';

interface PdpContent {
  page: { title: string; description: string };
  breadcrumbHtml: string;
  header: { h1: string; ledeHtml: string; eyebrow: string; h1Accent: string; features: string[] };
  how: { eyebrow: string; h2: string; intro: string; itemsHtml: string[] };
  choice: { eyebrow: string; h2: string; paragraphsHtml: string[]; cardTitles: string[] };
  changes: { eyebrow: string; badge: string; h2: string; blocks: { h3: string; textHtml: string }[] };
  pharmacies: { h2: string; textHtml: string };
  extraHelp: { eyebrow: string; h2: string; textHtml: string };
  callout: { heading: string; textHtml: string };
  cta: { eyebrow: string; h2Html: string; textHtml: string; scheduleLabel: string; callLabel: string; compareLabel: string };
}

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<PdpContent>('prescription-drug-plans', lang);
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
const vars = {
  phone: PHONE_DISPLAY,
  year: CURRENT.year,
  partDAnnualCap: usd(CURRENT.partD.annualCap),
  insulinCap: usd(CURRENT.partD.insulinCap),
};
const canonical = lang === DEFAULT_LOCALE ? '/prescription-drug-plans' : `/${lang}/prescription-drug-plans`;
const alternates = hreflangAlternates('prescription-drug-plans');
const href = (h: string) => localizeHref(h, lang);

// ---- Presentation only. Layout classes are shared with the other plan pages
// (ma-*, photo-frame-3d); every sentence and figure still comes from the JSON
// + figures.ts via interp().
const sentences = (html: string) => html.split(/(?<=\.)\s+(?=[A-ZÁÉÍÓÚÑ¿<])/);
const accentAt = c.header.h1Accent ? c.header.h1.lastIndexOf(c.header.h1Accent) : -1;
const h1Lead = accentAt > -1 ? c.header.h1.slice(0, accentAt) : c.header.h1;
const h1Accent = accentAt > -1 ? c.header.h1Accent : '';
const h1Tail = accentAt > -1 ? c.header.h1.slice(accentAt + c.header.h1Accent.length) : '';
// "Why plan choice matters": formulary sentence / cost-example sentences /
// pharmacies section (keeps its own h2) / "we review your medications".
const [formularyLead, ...formularyRest] = sentences(c.choice.paragraphsHtml[0]);
const choiceCards = [
  { title: c.choice.cardTitles[0], html: formularyLead },
  { title: c.choice.cardTitles[1], html: formularyRest.join(' ') },
  { title: c.pharmacies.h2, html: c.pharmacies.textHtml },
  { title: c.choice.cardTitles[2], html: c.choice.paragraphsHtml.slice(1).join(' ') },
];
// {year} changes: first block is the featured card; its figure token is
// wrapped before interp() so the CMS value (figures.ts) renders large.
const [capBlock, ...otherChanges] = c.changes.blocks;
const bigFigure = (h3: string) => interp(h3.replace(/\{(\w+)\}/, '<span class="pd-big">{$1}</span>'), vars);
// Bret's name/role/alt already exist (translated) in the homepage content.
const home = getPageContent<{ why: { card: { photoAlt: string; name: string; role: string } } }>('index', lang);

const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons = {
  pill: svg('<path d="M10.5 20.5l10-10a4.95 4.95 0 10-7-7l-10 10a4.95 4.95 0 107 7z"/><path d="M8.5 8.5l7 7"/>'),
  dollar: svg('<circle cx="12" cy="12" r="10"/><path d="M15 9.5a3 3 0 00-3-1.5c-1.7 0-3 .9-3 2.2 0 3 6 1.6 6 4.6 0 1.3-1.3 2.2-3 2.2a3.2 3.2 0 01-3-1.6M12 6v2M12 16v2"/>'),
  clipboard: svg('<path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 14l2 2 4-4"/>'),
  list: svg('<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>'),
  coins: svg('<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>'),
  store: svg('<path d="M3 9l1.5-5h15L21 9M3 9h18v11a1 1 0 01-1 1H4a1 1 0 01-1-1zM3 9a3 3 0 006 0 3 3 0 006 0 3 3 0 006 0"/><path d="M10 21v-6h4v6"/>'),
  person: svg('<path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>'),
  people: svg('<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>'),
  syringe: svg('<path d="M18 2l4 4M17 7l3-3M19 9L8.7 19.3a2.4 2.4 0 01-3.4 0l-.6-.6a2.4 2.4 0 010-3.4L15 5M9 11l4 4M5 19l-3 3M14 4l6 6"/>'),
  calendar: svg('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 15h3"/>'),
  check: svg('<path d="M20 6L9 17l-5-5"/>'),
  arrow: svg('<path d="M5 12h14M13 6l6 6-6 6"/>'),
  phone: svg('<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0122 16.92z"/>'),
};
const heroIcons = [icons.pill, icons.dollar, icons.clipboard];
const choiceIcons = [icons.list, icons.coins, icons.store, icons.person];
const changeIcons = [icons.syringe, icons.calendar];
---

<MainLayout
  title={c.page.title}
  description={interp(c.page.description, vars)}
  canonical={canonical}
>
  <Fragment slot="head">
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {lang !== DEFAULT_LOCALE && <meta property="og:locale" content={getLocaleMeta(lang).ogLocale} />}
  </Fragment>

<section class="page-header page-header--ma page-header--pd">
  <div class="container">
    <!-- Soft white "cloud" behind the copy keeps it readable over the clear photo. -->
    <div class="ma-hero-copy">
      <div class="breadcrumb" set:html={c.breadcrumbHtml}></div>
      <span class="ma-eyebrow ma-eyebrow--light">{c.header.eyebrow}</span>
      <h1>{h1Lead}{h1Accent && <span class="ma-accent">{h1Accent}</span>}{h1Tail}</h1>
      <AiSummary />
      <p class="lede" set:html={c.header.ledeHtml}></p>
      <ul class="ma-hero-features">
        {c.header.features.map((f, i) => (
          <li><span class="ma-hero-icon" set:html={heroIcons[i % heroIcons.length]} />{f}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- How Part D works: copy + check items left, drug artwork right -->
<section class="ma-section ma-intro">
  <div class="container ma-split">
    <div>
      <span class="ma-eyebrow">{c.how.eyebrow}</span>
      <h2>{c.how.h2}</h2>
      <p class="ma-lead">{c.how.intro}</p>
      <ul class="pd-checks">
        {c.how.itemsHtml.map((item) => (
          <li><span class="pd-check" set:html={icons.check} /><p set:html={item.replace(/<\/strong>\s*(&mdash;|—)\s*/, '</strong>')} /></li>
        ))}
      </ul>
    </div>
    <div class="ma-moop-card photo-frame-3d pd-art" aria-hidden="true">
      <div class="pd-art-card">
        <span class="pd-art-icon" set:html={icons.pill} />
        <span class="pd-art-label">{h1Accent || 'Part D'}</span>
      </div>
    </div>
  </div>
</section>

<!-- Why plan choice matters: four cards from the existing copy -->
<section class="ma-section ma-benefits">
  <div class="container">
    <span class="ma-eyebrow">{c.choice.eyebrow}</span>
    <h2>{c.choice.h2}</h2>
    <div class="ms-why-grid">
      {choiceCards.map((card, i) => (
        <article class="ma-benefit ms-why">
          <span class="ma-benefit-icon" set:html={choiceIcons[i]} />
          <h3>{card.title}</h3>
          <p set:html={card.html} />
        </article>
      ))}
    </div>
  </div>
</section>

<!-- {year} changes: featured cap card + the other changes -->
<section class="ma-section pd-changes">
  <div class="container ma-split pd-changes-split">
    <div>
      <span class="ma-eyebrow">{interp(c.changes.eyebrow, vars)}</span>
      <h2>{interp(c.changes.h2, vars)}</h2>
      <div class="pd-change-list">
        {otherChanges.map((b, i) => (
          <div class="ma-network">
            <span class="ma-network-icon" set:html={changeIcons[i % changeIcons.length]} />
            <div><strong>{interp(b.h3, vars)}</strong><p set:html={interp(b.textHtml, vars)} /></div>
          </div>
        ))}
      </div>
    </div>
    {capBlock && (
      <div class="pd-cap-card">
        <span class="pd-badge"><span set:html={icons.calendar} />{interp(c.changes.badge, vars)}</span>
        <h3 set:html={bigFigure(capBlock.h3)} />
        <p set:html={interp(capBlock.textHtml, vars)} />
      </div>
    )}
  </div>
</section>

<!-- Extra Help + free prescription review -->
<section class="ma-section ma-moop">
  <div class="container ma-split">
    <div>
      <span class="ma-eyebrow">{c.extraHelp.eyebrow}</span>
      <h2>{c.extraHelp.h2}</h2>
      <p class="ma-lead" set:html={c.extraHelp.textHtml}></p>
    </div>
    <figure class="ma-photo photo-frame-3d pd-help-photo">
      <img src="/images/Teton1.webp" alt={home.why.card.photoAlt} width="1672" height="941" loading="lazy" decoding="async" />
      <figcaption class="pd-review">
        <span class="ma-fit-icon" set:html={icons.people} />
        <div>
          <strong>{c.callout.heading}</strong>
          <p set:html={c.callout.textHtml}></p>
        </div>
      </figcaption>
    </figure>
  </div>
</section>

<!-- CTA -->
<section class="ma-cta">
  <div class="container">
    <div>
      <span class="ma-eyebrow ma-eyebrow--light">{c.cta.eyebrow}</span>
      <h2 set:html={c.cta.h2Html}></h2>
      <p set:html={c.cta.textHtml}></p>
    </div>
    <div class="ma-cta-actions">
      <a href={href('contact.html')} class="ma-btn-gold">{c.cta.scheduleLabel}<span set:html={icons.arrow} /></a>
      <a href="tel:4352925548" class="ma-cta-phone"><span set:html={icons.phone} />{interp(c.cta.callLabel, vars)}</a>
      <a href={COMPARE_PLANS_URL} target="_blank" rel="noopener" class="ma-cta-compare">{c.cta.compareLabel}<span set:html={icons.arrow} /></a>
    </div>
  </div>
</section>

<div class="basics-tools">
<HelpfulTools />
</div>

</MainLayout>
