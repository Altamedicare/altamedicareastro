---
// src/components/content/Turning65Page.astro — THE shared Turning 65 template.
// Copy lives in src/i18n/content/{locale}/turning-65.json; presentation only.
// The tools band is LocationTools (consts.ts TOOLS registry) rather than the
// generic HelpfulTools trio: this page is about enrollment TIMING, so it shows
// the four timing/penalty calculators instead of the sitewide default set.
// Band chrome reuses the existing t('tools.*') dictionary — no new copy, so
// English and Spanish stay in parity without a translation pass.
import MainLayout from '../../layouts/MainLayout.astro';
import AiSummary from '../AiSummary.astro';
import LocationTools from '../location/LocationTools.astro';
import { DEFAULT_LOCALE, getLangFromUrl, getLocaleMeta, t } from '../../i18n/locales';
import { getPageContent, hreflangAlternates, interp, localizeHref } from '../../i18n/content';
import { breadcrumbLd, crumbsFromHtml } from '../../i18n/breadcrumbs';
import { PHONE_DISPLAY } from '../../consts';

interface Turning65Content {
  page: { title: string; description: string };
  breadcrumbHtml: string;
  header: { h1Html: string; ledeHtml: string; eyebrow: string; h1Accent: string; features: string[]; card: { title: string; items: string[] } };
  timeline: {
    eyebrow: string;
    h2: string;
    introHtml: string;
    items: { age: string; h4Html: string; textHtml: string }[];
  };
  situations: { eyebrow: string; h2: string; blocks: { h3Html: string; textHtml: string }[] };
  penalties: { eyebrow: string; h2: string; blocks: { h3Html: string; textHtml: string }[] };
  callout: { heading: string; textHtml: string };
  cta: { eyebrow: string; h2Html: string; textHtml: string; scheduleLabel: string; callLabel: string };
}

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<Turning65Content>('turning-65', lang);
const vars = { phone: PHONE_DISPLAY };
const canonical = lang === DEFAULT_LOCALE ? '/turning-65' : `/${lang}/turning-65`;
const alternates = hreflangAlternates('turning-65');
// Schema built from the SAME string the breadcrumb renders (Home › Turning 65).
const crumbLd = breadcrumbLd(crumbsFromHtml(c.breadcrumbHtml), lang, canonical);
const href = (h: string) => localizeHref(h, lang);

// ---- Presentation only (visual redesign; every sentence comes from the JSON).
// Headline accent: wrap the h1Accent phrase if the locale's h1 contains it.
const h1 = c.header.h1Accent && c.header.h1Html.includes(c.header.h1Accent)
  ? c.header.h1Html.replace(c.header.h1Accent, `<span class="ma-accent">${c.header.h1Accent}</span>`)
  : c.header.h1Html;
// "Turning 65? Here's…" → break after the question so the roadmap line reads as its own line.
const h1Html = h1.replace(/\?\s+/, '?<br />');

const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons = {
  calendar: svg('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/>'),
  shield: svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>'),
  people: svg('<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>'),
  book: svg('<path d="M2 4h7a3 3 0 013 3v13a2 2 0 00-2-2H2z"/><path d="M22 4h-7a3 3 0 00-3 3v13a2 2 0 012-2h8z"/>'),
  doc: svg('<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>'),
  cake: svg('<path d="M20 21v-8a2 2 0 00-2-2H6a2 2 0 00-2 2v8M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1M2 21h20M7 8v3M12 8v3M17 8v3M7 4h.01M12 4h.01M17 4h.01"/>'),
  check: svg('<circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/>'),
  refresh: svg('<path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>'),
  briefcase: svg('<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>'),
  piggy: svg('<path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2V5z"/><path d="M2 9v1c0 1.1.9 2 2 2h1M16 11h.01"/>'),
  bank: svg('<path d="M3 21h18M4 18h16M6 18v-7M10 18v-7M14 18v-7M18 18v-7M12 3l9 5H3z"/>'),
  steth: svg('<path d="M4.8 2.3A.3.3 0 105 2H4a2 2 0 00-2 2v5a6 6 0 006 6 6 6 0 006-6V4a2 2 0 00-2-2h-1a.2.2 0 10.3.3"/><path d="M8 15v1a6 6 0 006 6 6 6 0 006-6v-4"/><circle cx="20" cy="10" r="2"/>'),
  pill: svg('<path d="M10.5 20.5l10-10a4.95 4.95 0 10-7-7l-10 10a4.95 4.95 0 107 7z"/><path d="M8.5 8.5l7 7"/>'),
  alert: svg('<path d="M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/><path d="M12 9v4M12 17h.01"/>'),
  tick: svg('<path d="M20 6L9 17l-5-5"/>'),
  arrow: svg('<path d="M5 12h14M13 6l6 6-6 6"/>'),
  phone: svg('<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0122 16.92z"/>'),
};
const heroIcons = [icons.calendar, icons.shield, icons.people];
const stepIcons = [icons.book, icons.doc, icons.cake, icons.check, icons.refresh];
const situationIcons = [icons.briefcase, icons.piggy, icons.shield, icons.bank];
const penaltyIcons = [icons.steth, icons.pill];
---

<MainLayout
  title={c.page.title}
  description={c.page.description}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbLd)} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {lang !== DEFAULT_LOCALE && <meta property="og:locale" content={getLocaleMeta(lang).ogLocale} />}
  </Fragment>

<section class="page-header page-header--ma page-header--t65">
  <div class="container t65-hero-grid">
    <!-- Soft white "cloud" behind the copy keeps it readable over the clear photo. -->
    <div class="ma-hero-copy">
      <div class="breadcrumb" set:html={c.breadcrumbHtml}></div>
      <span class="ma-eyebrow ma-eyebrow--light">{c.header.eyebrow}</span>
      <h1 set:html={h1Html}></h1>
      <AiSummary />
      <p class="lede" set:html={c.header.ledeHtml}></p>
      <ul class="ma-hero-features">
        {c.header.features.map((f, i) => (
          <li><span class="ma-hero-icon" set:html={heroIcons[i % heroIcons.length]} />{f}</li>
        ))}
      </ul>
    </div>
    <aside class="t65-hero-card">
      <strong>{c.header.card.title}</strong>
      <ul>
        {c.header.card.items.map((it) => <li><span set:html={icons.tick} />{it}</li>)}
      </ul>
    </aside>
  </div>
</section>

<!-- Five-step journey (the page's centerpiece) -->
<section class="t65-timeline">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{c.timeline.eyebrow}</span>
      <h2>{c.timeline.h2}</h2>
      <p set:html={c.timeline.introHtml}></p>
    </div>
    <ol class="t65-steps">
      {c.timeline.items.map((item, i) => (
        <li class="t65-step tilt-3d">
          <span class="t65-step-num">{i + 1}</span>
          <span class="t65-step-icon" set:html={stepIcons[i % stepIcons.length]} />
          <span class="t65-step-age">{item.age}</span>
          <h3 set:html={item.h4Html} />
          <p set:html={item.textHtml} />
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Common situations -->
<section class="ma-section ma-benefits t65-situations">
  <div class="container">
    <span class="ma-eyebrow">{c.situations.eyebrow}</span>
    <h2>{c.situations.h2}</h2>
    <div class="t65-situation-grid">
      {c.situations.blocks.map((b, i) => (
        <article class="t65-situation tilt-3d">
          <span class="t65-situation-icon" set:html={situationIcons[i % situationIcons.length]} />
          <div>
            <h3 set:html={b.h3Html} />
            <p set:html={b.textHtml} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Penalties to avoid -->
<section class="ma-section t65-penalties">
  <div class="container">
    <span class="ma-eyebrow">{c.penalties.eyebrow}</span>
    <h2>{c.penalties.h2}</h2>
    <div class="t65-penalty-grid">
      {c.penalties.blocks.map((b, i) => (
        <article class="t65-penalty tilt-3d">
          <span class="t65-penalty-icon" set:html={penaltyIcons[i % penaltyIcons.length]} />
          <div>
            <h3 set:html={b.h3Html} />
            <p set:html={b.textHtml} />
          </div>
        </article>
      ))}
    </div>
    <div class="t65-good-news">
      <span class="t65-good-news-icon" set:html={icons.alert} />
      <div>
        <strong>{c.callout.heading}</strong>
        <p set:html={c.callout.textHtml}></p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="ma-cta">
  <div class="container">
    <div>
      <span class="ma-eyebrow ma-eyebrow--light">{c.cta.eyebrow}</span>
      <h2 set:html={c.cta.h2Html}></h2>
      <p set:html={c.cta.textHtml}></p>
    </div>
    <div class="ma-cta-actions">
      <a href={href('contact.html')} class="ma-btn-gold">{c.cta.scheduleLabel}<span set:html={icons.arrow} /></a>
      <a href="tel:4352925548" class="ma-cta-phone"><span set:html={icons.phone} />{interp(c.cta.callLabel, vars)}</a>
    </div>
  </div>
</section>

<div class="basics-tools t65-tools">
<LocationTools
  tools={['eligibility', 'timeline', 'countdown', 'penalty']}
  heading={t('tools.h2', lang)}
  sub={t('tools.intro', lang)}
/>
</div>

<!-- Pointer-follow tilt for .tilt-3d boxes (and the tools band cards). Fine pointers only;
     skipped entirely for prefers-reduced-motion. -->
<script is:inline>
(function(){
  if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  document.querySelectorAll('.t65-tools .card').forEach(function(el){ el.classList.add('tilt-3d'); });
  document.querySelectorAll('.tilt-3d').forEach(function(el){
    el.addEventListener('pointermove', function(e){
      var r = el.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
      el.style.setProperty('--ry', ((x - 0.5) * 10).toFixed(2) + 'deg');
      el.style.setProperty('--rx', ((0.5 - y) * 8).toFixed(2) + 'deg');
      el.style.setProperty('--gx', (x * 100).toFixed(1) + '%');
      el.style.setProperty('--gy', (y * 100).toFixed(1) + '%');
      el.classList.add('is-tilting');
    });
    el.addEventListener('pointerleave', function(){
      el.classList.remove('is-tilting'); el.style.removeProperty('--rx'); el.style.removeProperty('--ry');
    });
  });
})();
</script>

</MainLayout>
