---
// src/components/content/DentalVisionHearingPage.astro — THE shared template.
// Copy lives in src/i18n/content/{locale}/dental-vision-hearing.json.
// DVH title/H1/copy/links are frozen pending GSC data — this template only
// renders the master copy (and its translation); it never rewords it.
import MainLayout from '../../layouts/MainLayout.astro';
import AiSummary from '../AiSummary.astro';
import LocationTools from '../location/LocationTools.astro';
import { DEFAULT_LOCALE, getLangFromUrl, getLocaleMeta, t } from '../../i18n/locales';
import { getPageContent, hreflangAlternates, interp, localizeHref } from '../../i18n/content';
import { breadcrumbLd, crumbsFromHtml } from '../../i18n/breadcrumbs';
import { COMPARE_PLANS_URL, PHONE_DISPLAY } from '../../consts';

interface OptionCard { h2?: string; h2Html?: string; textHtml: string; note?: string }
interface DvhContent {
  page: { title: string; description: string };
  breadcrumbHtml: string;
  header: { eyebrow: string; h1: string; ledeHtml: string; features: string[] };
  gaps: { eyebrow: string; h2Html: string; introHtml: string; items: string[]; goodNews: string };
  options: { eyebrow: string; cards: OptionCard[] };
  lookFor: { eyebrow: string; h2: string; intro: string; items: { t: string; d: string }[] };
  fit: { headingHtml: string; textHtml: string };
  cta: { eyebrow: string; h2: string; textHtml: string; scheduleLabel: string; callLabel: string; compareLabel: string };
}

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<DvhContent>('dental-vision-hearing', lang);
const vars = { phone: PHONE_DISPLAY };
const canonical = lang === DEFAULT_LOCALE ? '/dental-vision-hearing' : `/${lang}/dental-vision-hearing`;
const alternates = hreflangAlternates('dental-vision-hearing');
// Mirrors the visible trail exactly — no invented levels.
const crumbLd = breadcrumbLd(crumbsFromHtml(c.breadcrumbHtml), lang, canonical);

const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons = {
  tooth: svg('<path d="M12 5.5C10 3 6 3 5 6c-1 3 .5 6 1.5 9 .7 2 1 5 2.5 5s1.5-4 3-4 1.5 4 3 4 1.8-3 2.5-5c1-3 2.5-6 1.5-9-1-3-5-3-7-.5z"/>'),
  eye: svg('<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'),
  ear: svg('<path d="M6 8.5a6 6 0 1112 0c0 3.5-3 4.5-3 7.5a3.5 3.5 0 01-6.5 1.8"/><path d="M9 8.5a3 3 0 016 0"/>'),
  info: svg('<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>'),
  check: svg('<path d="M20 6L9 17l-5-5"/>'),
  calendar: svg('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>'),
  clock: svg('<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>'),
  people: svg('<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>'),
  dollar: svg('<circle cx="12" cy="12" r="10"/><path d="M15 9.5a3 3 0 00-3-1.5c-1.7 0-3 .9-3 2.2 0 3 6 1.6 6 4.6 0 1.3-1.3 2.2-3 2.2a3.2 3.2 0 01-3-1.6M12 6v2M12 16v2"/>'),
  hand: svg('<path d="M11 14h2a2 2 0 000-4h-3c-.6 0-1.1.2-1.4.6L3 16"/><path d="M7 20l1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 00-2.75-2.91l-4.2 3.9"/><path d="M2 15l6 6"/>'),
  phone: svg('<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0122 16.92z"/>'),
  arrow: svg('<path d="M5 12h14M13 6l6 6-6 6"/>'),
};
const heroIcons = [icons.tooth, icons.eye, icons.ear];
const optionIcons = [icons.tooth, icons.eye, icons.ear];
const lookIcons = [icons.calendar, icons.clock, icons.people, icons.dollar, icons.eye];
---

<MainLayout
  title={c.page.title}
  description={c.page.description}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbLd)} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {lang !== DEFAULT_LOCALE && <meta property="og:locale" content={getLocaleMeta(lang).ogLocale} />}
  </Fragment>

<section class="page-header page-header--ma page-header--dvh">
  <div class="container">
    <!-- Soft white "cloud" behind the copy keeps it readable over the clear photo. -->
    <div class="ma-hero-copy">
      <div class="breadcrumb" set:html={c.breadcrumbHtml}></div>
      <span class="ma-eyebrow ma-eyebrow--light" set:html={c.header.eyebrow}></span>
      <h1>{c.header.h1}</h1>
      <AiSummary />
      <p class="lede" set:html={c.header.ledeHtml}></p>
      <ul class="ma-hero-features">
        {c.header.features.map((f, i) => (
          <li><span class="ma-hero-icon" set:html={heroIcons[i % heroIcons.length]} />{f}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- What Original Medicare doesn't cover -->
<section class="ma-section ma-intro">
  <div class="container ma-split">
    <div>
      <span class="ma-eyebrow">{c.gaps.eyebrow}</span>
      <h2 set:html={c.gaps.h2Html}></h2>
      <p class="ma-lead" set:html={c.gaps.introHtml}></p>
      <ul class="dvh-gaps">
        {c.gaps.items.map((g, i) => <li><span class="dvh-gap-icon" set:html={heroIcons[i % heroIcons.length]} />{g}</li>)}
      </ul>
      <div class="ma-info dvh-goodnews">
        <span class="ma-info-icon" set:html={icons.info} />
        <p>{c.gaps.goodNews}</p>
      </div>
    </div>
    <div class="ma-moop-card photo-frame-3d dvh-trio" aria-hidden="true">
      <div class="dvh-trio-card">
        <span class="dvh-trio-icon" set:html={icons.tooth} />
        <span class="dvh-trio-icon dvh-trio-icon--gold" set:html={icons.eye} />
        <span class="dvh-trio-icon dvh-trio-icon--sky" set:html={icons.ear} />
      </div>
    </div>
  </div>
</section>

<!-- Three ways to get coverage -->
<section class="ma-section ma-benefits">
  <div class="container">
    <span class="ma-eyebrow">{c.options.eyebrow}</span>
    <div class="dvh-options">
      {c.options.cards.map((o, i) => (
        <article class={`dvh-option dvh-option--${i + 1}`}>
          <div class="dvh-option-top"><span class="dvh-num">{String(i + 1).padStart(2, '0')}</span><span class="dvh-option-icon" set:html={optionIcons[i % optionIcons.length]} /></div>
          {o.h2Html ? <h2 set:html={o.h2Html} /> : <h2>{o.h2}</h2>}
          <p set:html={o.textHtml} />
          {o.note && <p class="dvh-option-note"><span set:html={icons.check} />{o.note}</p>}
        </article>
      ))}
    </div>
  </div>
</section>

<!-- What to look for -->
<section class="ma-section ma-moop">
  <div class="container dvh-look">
    <div>
      <span class="ma-eyebrow">{c.lookFor.eyebrow}</span>
      <h2>{c.lookFor.h2}</h2>
      <p class="ma-lead">{c.lookFor.intro}</p>
    </div>
    <div>
      <ul class="dvh-checklist">
        {c.lookFor.items.map((it, i) => (
          <li><span class="dvh-check-icon" set:html={lookIcons[i % lookIcons.length]} /><p><strong>{it.t}</strong> &mdash; {it.d}</p></li>
        ))}
      </ul>
      <div class="dvh-fit">
        <span class="dvh-fit-icon" set:html={icons.hand} />
        <div>
          <strong set:html={c.fit.headingHtml}></strong>
          <p set:html={c.fit.textHtml}></p>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="basics-tools dvh-tools">
<LocationTools
  tools={['quiz', 'cost-estimator']}
  heading={t('tools.h2', lang)}
  sub={t('tools.intro', lang)}
/>
</div>

<!-- CTA -->
<section class="ma-cta">
  <div class="container">
    <div>
      <span class="ma-eyebrow ma-eyebrow--light">{c.cta.eyebrow}</span>
      <h2>{c.cta.h2}</h2>
      <p set:html={c.cta.textHtml}></p>
    </div>
    <div class="ma-cta-actions">
      <a href={localizeHref('/contact', lang)} class="ma-btn-gold">{c.cta.scheduleLabel}<span set:html={icons.arrow} /></a>
      <a href="tel:4352925548" class="ma-cta-phone"><span set:html={icons.phone} />{interp(c.cta.callLabel, vars)}</a>
      <a href={COMPARE_PLANS_URL} target="_blank" rel="noopener" class="ma-cta-compare">{c.cta.compareLabel}<span set:html={icons.arrow} /></a>
    </div>
  </div>
</section>

</MainLayout>
