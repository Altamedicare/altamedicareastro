---
// src/components/content/AboutPage.astro — THE shared About template.
// Rendered by both the master route (src/pages/about.astro, thin wrapper) and
// the dynamic localized route (src/pages/[locale]/[...path].astro). Copy lives
// in src/i18n/content/{locale}/about.json; this file is presentation only.
// {phone} interpolates from consts.ts so the number never lives in
// translatable copy (§6.8).
import MainLayout from '../../layouts/MainLayout.astro';
import AiSummary from '../AiSummary.astro';
import { DEFAULT_LOCALE, getLangFromUrl, getLocaleMeta } from '../../i18n/locales';
import { getPageContent, hreflangAlternates, interp, localizeHref } from '../../i18n/content';
import { PHONE_DISPLAY } from '../../consts';

interface AboutContent {
  page: { title: string; description: string };
  breadcrumbHtml: string;
  header: { h1: string; ledeHtml: string; eyebrow: string; h1Accent: string };
  card: { photoAlt: string; name: string; roleHtml: string; location: string };
  body: {
    h2Why: string;
    whyHtml: string[];
    h2Expect: string;
    expectItemsHtml: string[];
    h2Mission: string;
    missionHtml: string;
    storyEyebrow: string;
    expectEyebrow: string;
    missionAccent: string;
  };
  callout: { heading: string; textHtml: string };
  cta: { h2Html: string; textHtml: string; scheduleLabel: string; callLabel: string };
}

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<AboutContent>('about', lang);
const vars = { phone: PHONE_DISPLAY };
const canonical = lang === DEFAULT_LOCALE ? '/about' : `/${lang}/about`;
const alternates = hreflangAlternates('about');
// Relative asset paths resolve against /es/ on localized pages — absolutize
// there; untouched (byte-stable) on the English master.
const asset = (p: string) => (lang === DEFAULT_LOCALE || p.startsWith('/') ? p : `/${p}`);
// The photo below used to point at images/bret-photo.svg, which never existed
// and 404'd on every render; an onerror handler hid the broken image, so the
// card silently shipped photoless. It now uses the bret-* derivatives of
// BretSwope.webp — the same asset and treatment as the homepage .bret-photo
// card — and the handler is gone, because masking the failure is what kept the
// bug invisible. Derivatives are generated by scripts/gen-bret-derivatives.mjs.
const href = (h: string) => localizeHref(h, lang);

// ---- Presentation only (visual redesign; every sentence comes from the JSON).
const accentAt = c.header.h1Accent ? c.header.h1.lastIndexOf(c.header.h1Accent) : -1;
const h1Lead = accentAt > -1 ? c.header.h1.slice(0, accentAt) : c.header.h1;
const h1Accent = accentAt > -1 ? c.header.h1Accent : '';
const mission = c.body.missionAccent && c.body.missionHtml.includes(c.body.missionAccent)
  ? c.body.missionHtml.replace(c.body.missionAccent, `<span class="ab-gold">${c.body.missionAccent}</span>`)
  : c.body.missionHtml;
// "What you can expect": first three items are the value cards, the rest the
// guidance list — each item is "<strong>Title.</strong> detail".
const expect = c.body.expectItemsHtml.map((html) => {
  const m = html.match(/^<strong>(.*?)\.?<\/strong>\s*(.*)$/s);
  return m ? { title: m[1], detail: m[2] } : { title: '', detail: html };
});
const values = expect.slice(0, 3);
const guidance = expect.slice(3);
// Bret's own quote already shown (and translated) on the homepage card.
const home = getPageContent<{ why: { card: { quote: string; name: string } } }>('index', lang);

const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons = {
  cap: svg('<path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5M22 10v6"/>'),
  pin: svg('<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>'),
  people: svg('<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>'),
  calendar: svg('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01"/>'),
  phone: svg('<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0122 16.92z"/>'),
  chat: svg('<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>'),
  arrow: svg('<path d="M5 12h14M13 6l6 6-6 6"/>'),
};
const valueIcons = [icons.cap, icons.pin, icons.people];
const guidanceIcons = [icons.calendar, icons.phone];
---

<MainLayout
  title={c.page.title}
  description={c.page.description}
  canonical={canonical}
>
  <Fragment slot="head">
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {lang !== DEFAULT_LOCALE && <meta property="og:locale" content={getLocaleMeta(lang).ogLocale} />}
  </Fragment>

<section class="page-header page-header--ma page-header--about">
  <div class="container">
    <!-- Soft white "cloud" behind the copy keeps it readable over the clear photo. -->
    <div class="ma-hero-copy">
      <div class="breadcrumb" set:html={c.breadcrumbHtml}></div>
      <span class="ma-eyebrow ma-eyebrow--light">{c.header.eyebrow}</span>
      <h1 id="bret-swope">{h1Lead}{h1Accent && <span class="ma-accent">{h1Accent}</span>}</h1>
      <AiSummary />
      <p class="lede" set:html={c.header.ledeHtml}></p>
      <div class="ab-hero-actions">
        <a href={href('contact.html')} class="ma-btn-gold">{c.cta.scheduleLabel}<span set:html={icons.arrow} /></a>
        <a href="tel:4352925548" class="ab-btn-outline"><span set:html={icons.phone} />{interp(c.cta.callLabel, vars)}</a>
      </div>
    </div>
  </div>
</section>

<!-- My story: portrait card + why I started -->
<section class="ma-section ab-story">
  <div class="container ab-story-grid">
    <figure class="ab-portrait photo-frame-3d photo-frame-3d--tilt-right">
      <img src={asset('images/bret-540.webp')} srcset={`${asset('images/bret-360.webp')} 360w, ${asset('images/bret-540.webp')} 540w`} sizes="(max-width: 900px) 90vw, 420px" alt={c.card.photoAlt} width="540" height="540" loading="lazy" decoding="async" />
      <figcaption>
        <strong>{c.card.name}</strong>
        <span class="role" set:html={c.card.roleHtml}></span>
        <span class="ab-loc"><span set:html={icons.pin} />{c.card.location}</span>
      </figcaption>
    </figure>
    <div>
      <span class="ma-eyebrow">{c.body.storyEyebrow}</span>
      <h2>{c.body.h2Why}</h2>
      {c.body.whyHtml.map((p) => <p class="ma-lead" set:html={p} />)}
    </div>
  </div>
</section>

<!-- What you can expect: three value cards, then guidance + Bret's quote -->
<section class="ma-section ab-expect">
  <div class="container">
    <span class="ma-eyebrow">{c.body.expectEyebrow}</span>
    <h2>{c.body.h2Expect}</h2>
    <div class="ab-values">
      {values.map((v, i) => (
        <article class="ab-value tilt-3d">
          <span class="ab-value-icon" set:html={valueIcons[i % valueIcons.length]} />
          <div><h3 set:html={v.title} /><p set:html={v.detail} /></div>
        </article>
      ))}
    </div>
    <div class="ab-guidance">
      <div>
        <ul class="ab-guidance-list">
          {guidance.map((g, i) => (
            <li><span class="ab-g-icon" set:html={guidanceIcons[i % guidanceIcons.length]} /><div><h3 set:html={g.title} /><p set:html={g.detail} /></div></li>
          ))}
        </ul>
        <div class="ab-chat">
          <span class="ab-g-icon ab-g-icon--gold" set:html={icons.chat} />
          <div>
            <strong>{c.callout.heading}</strong>
            <p set:html={interp(c.callout.textHtml, vars)}></p>
          </div>
        </div>
      </div>
      <figure class="ab-quote-photo photo-frame-3d">
        <img src="/images/teton-mobile.webp" alt="" width="1000" height="563" loading="lazy" decoding="async" />
        <blockquote>
          <p>{home.why.card.quote}</p>
          <cite>&mdash; {home.why.card.name}</cite>
        </blockquote>
      </figure>
    </div>
  </div>
</section>

<!-- Mission banner -->
<section class="ab-mission">
  <div class="container">
    <span class="ma-eyebrow ma-eyebrow--light">{c.body.h2Mission}</span>
    <p class="ab-mission-text" set:html={mission}></p>
  </div>
</section>

<!-- CTA -->
<section class="ma-cta">
  <div class="container">
    <div>
      <h2 set:html={c.cta.h2Html}></h2>
      <p set:html={c.cta.textHtml}></p>
    </div>
    <div class="ma-cta-actions">
      <a href={href('contact.html')} class="ma-btn-gold">{c.cta.scheduleLabel}<span set:html={icons.arrow} /></a>
      <a href="tel:4352925548" class="ma-cta-phone"><span set:html={icons.phone} />{interp(c.cta.callLabel, vars)}</a>
    </div>
  </div>
</section>

<!-- Pointer-follow tilt for the value cards (fine pointers only; skipped for reduced motion). -->
<script is:inline>
(function(){
  if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  document.querySelectorAll('.ab-value.tilt-3d').forEach(function(el){
    el.addEventListener('pointermove', function(e){
      var r = el.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
      el.style.setProperty('--ry', ((x - 0.5) * 10).toFixed(2) + 'deg');
      el.style.setProperty('--rx', ((0.5 - y) * 8).toFixed(2) + 'deg');
      el.style.setProperty('--gx', (x * 100).toFixed(1) + '%');
      el.style.setProperty('--gy', (y * 100).toFixed(1) + '%');
      el.classList.add('is-tilting');
    });
    el.addEventListener('pointerleave', function(){
      el.classList.remove('is-tilting'); el.style.removeProperty('--rx'); el.style.removeProperty('--ry');
    });
  });
})();
</script>

</MainLayout>
