---
// src/components/content/MedicareAdvantagePage.astro — THE shared template.
// Copy lives in src/i18n/content/{locale}/medicare-advantage.json.
import MainLayout from '../../layouts/MainLayout.astro';
import AiSummary from '../AiSummary.astro';
import HelpfulTools from '../HelpfulTools.astro';
import { DEFAULT_LOCALE, getLangFromUrl, getLocaleMeta } from '../../i18n/locales';
import { getPageContent, hreflangAlternates, interp, localizeHref } from '../../i18n/content';
import { breadcrumbLd, crumbsFromHtml } from '../../i18n/breadcrumbs';
import { PLACES, getLocationCopy, hubHref, pageHref } from '../../data/places';
import { COMPARE_PLANS_URL, PHONE_DISPLAY } from '../../consts';

interface MaContent {
  page: { title: string; description: string };
  breadcrumbHtml: string;
  header: { h1: string; ledeHtml: string; eyebrow: string; h1Accent: string; features: string[] };
  includes: {
    eyebrow: string;
    benefitsEyebrow: string;
    networksEyebrow: string;
    networkTypes: { __name: string; textHtml: string }[];
    moopEyebrow: string;
    h2: string;
    introHtml: string;
    benefitsH3: string;
    benefitsHtml: string[];
    networksH3: string;
    networksHtml: string;
    moopH3: string;
    moopHtml: string;
  };
  fit: { eyebrow: string; h2: string; intro: string; itemsHtml: string[] };
  related: { eyebrow: string };
  /** Optional until translated — existence-aware, same rule as every other
   *  localized surface here: a locale renders the section only once its copy is
   *  committed. Never falls back to English prose on a Spanish page. */
  notFit?: { h2: string; intro: string; itemsHtml: string[] };
  callout: { heading: string; textHtml: string };
  cta: { h2Html: string; textHtml: string; scheduleLabel: string; callLabel: string; compareLabel: string };
}

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<MaContent>('medicare-advantage', lang);
const vars = { phone: PHONE_DISPLAY };
const canonical = lang === DEFAULT_LOCALE ? '/medicare-advantage' : `/${lang}/medicare-advantage`;
const alternates = hreflangAlternates('medicare-advantage');
// Schema mirrors the rendered trail (Home › Plans › Medicare Advantage).
const crumbLd = breadcrumbLd(crumbsFromHtml(c.breadcrumbHtml), lang, canonical);

// Utah cluster links. Labels reuse the location module's already-translated
// "Medicare Advantage in {placeName}" / "Medicare en {placeName}" templates, so
// this section needs no new copy in any locale. The state hub heads the block;
// its counties follow. Nothing here is hand-written per place.
// LocationCopy widens its leaf values to `unknown` (the shared module is
// mask-driven), so callers cast at the edge — same as LocationOverview does.
const loc = getLocationCopy(lang);
const maLabel = loc.overview.maH2 as string;
const placeLabel = loc.shell.crumbPlace as string;
const utah = PLACES.find((p) => p.kind === 'state')!;
const counties = PLACES.filter((p) => p.kind === 'county');
const utahH2 = interp(maLabel, { placeName: utah.name });
const utahHubLink = {
  href: localizeHref(hubHref(utah), lang),
  label: interp(placeLabel, { placeName: utah.name }),
};
// Phase 7: this block listed the state hub and jumped straight to the counties,
// bypassing the statewide Utah MA pillar entirely — one reason that page had
// only 2 contextual inbound links. The label reuses the location module's
// already-translated "Read the full guide…" template, so no new copy anywhere.
const utahMaLink = {
  href: localizeHref(pageHref(utah, 'medicare-advantage'), lang),
  labelHtml: interp(loc.overview.maLinkLabelHtml as string, { placeName: utah.name }),
};
const countyLinks = counties.map((p) => ({
  href: localizeHref(pageHref(p, 'medicare-advantage'), lang),
  label: interp(maLabel, { placeName: p.name }),
}));

// Hoisted so TS narrowing survives into the JSX below (`c.notFit &&` alone does
// not narrow inside child expressions). Absent until the locale is translated.
const notFit = c.notFit;

// ---- Presentation helpers (layout only; every sentence comes from the JSON) ----
// Split copy into sentences so one paragraph can feed two visual slots without
// rewording it (e.g. the MOOP sentence goes into the highlighted box).
const sentences = (html: string) => html.split(/(?<=\.)\s+(?=[A-ZÁÉÍÓÚÑ¿<])/);
const [introLead, ...introRest] = sentences(c.includes.introHtml);
const [moopLead, ...moopRest] = sentences(c.includes.moopHtml);
const netParts = sentences(c.includes.networksHtml);
const netLead = netParts[0];
const netVerify = netParts.length > 2 ? netParts.slice(2).join(' ') : '';
// Headline accent ("in Utah") — plain h1 if the locale's h1 lacks it.
const accentAt = c.header.h1Accent ? c.header.h1.lastIndexOf(c.header.h1Accent) : -1;
const h1Lead = accentAt > -1 ? c.header.h1.slice(0, accentAt) : c.header.h1;
const h1Tail = accentAt > -1 ? c.header.h1.slice(accentAt) : '';
// Bret's name/role/alt already exist (translated) on the homepage content.
const home = getPageContent<{ why: { card: { photoAlt: string; name: string; role: string } } }>('index', lang);

const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons = {
  shield: svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>'),
  people: svg('<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>'),
  dollar: svg('<circle cx="12" cy="12" r="10"/><path d="M15 9.5a3 3 0 00-3-1.5c-1.7 0-3 .9-3 2.2 0 3 6 1.6 6 4.6 0 1.3-1.3 2.2-3 2.2a3.2 3.2 0 01-3-1.6M12 6v2M12 16v2"/>'),
  info: svg('<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>'),
  check: svg('<path d="M20 6L9 17l-5-5"/>'),
  swap: svg('<path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 014-4h14M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 01-4 4H3"/>'),
  pin: svg('<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>'),
  arrow: svg('<path d="M5 12h14M13 6l6 6-6 6"/>'),
  phone: svg('<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0122 16.92z"/>'),
};
const heroIcons = [icons.shield, icons.people, icons.dollar];
// One icon per existing benefit, in source order (hospital, drugs, dental,
// vision, hearing, OTC, transportation, fitness).
const benefitIcons = [
  svg('<path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 00-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 000-7.8z"/><path d="M3.5 12h4l2-3 3 6 2-3h6"/>'),
  svg('<path d="M10.5 20.5l10-10a4.95 4.95 0 10-7-7l-10 10a4.95 4.95 0 107 7z"/><path d="M8.5 8.5l7 7"/>'),
  svg('<path d="M12 5.5C10 3 6 3 5 6c-1 3 .5 6 1.5 9 .7 2 1 5 2.5 5s1.5-4 3-4 1.5 4 3 4 1.8-3 2.5-5c1-3 2.5-6 1.5-9-1-3-5-3-7-.5z"/>'),
  svg('<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'),
  svg('<path d="M6 8.5a6 6 0 1112 0c0 3.5-3 4.5-3 7.5a3.5 3.5 0 01-6.5 1.8"/><path d="M9 8.5a3 3 0 016 0"/>'),
  svg('<path d="M6 2l-3 4v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18M12 10v6M9 13h6"/>'),
  svg('<path d="M5 17h14M5 17a2 2 0 104 0M15 17a2 2 0 104 0"/><path d="M3 17V11l2-5h14l2 5v6"/><path d="M3 11h18"/>'),
  svg('<path d="M6.5 6.5l11 11M21 21l-1-1M3 3l1 1M18 22l4-4M2 6l4-4M3 10l7-7M14 21l7-7"/>'),
];
---

<MainLayout
  title={c.page.title}
  description={c.page.description}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbLd)} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {lang !== DEFAULT_LOCALE && <meta property="og:locale" content={getLocaleMeta(lang).ogLocale} />}
  </Fragment>

<section class="page-header page-header--ma">
  <div class="container">
    <!-- Soft white "cloud" behind the copy keeps it readable over the clear photo. -->
    <div class="ma-hero-copy">
      <div class="breadcrumb" set:html={c.breadcrumbHtml}></div>
      <span class="ma-eyebrow ma-eyebrow--light">{c.header.eyebrow}</span>
      <h1>{h1Lead}{h1Tail && <span class="ma-accent">{h1Tail}</span>}</h1>
      <AiSummary />
      <p class="lede" set:html={c.header.ledeHtml}></p>
      <ul class="ma-hero-features">
        {c.header.features.map((f, i) => (
          <li><span class="ma-hero-icon" set:html={heroIcons[i % heroIcons.length]} />{f}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- What Medicare Advantage includes: copy left, photo right -->
<section class="ma-section ma-intro">
  <div class="container ma-split">
    <div>
      <span class="ma-eyebrow">{c.includes.eyebrow}</span>
      <h2>{c.includes.h2}</h2>
      <p class="ma-lead" set:html={introLead}></p>
      {introRest.length > 0 && (
        <div class="ma-info">
          <span class="ma-info-icon" set:html={icons.info} />
          <p set:html={introRest.join(' ')}></p>
        </div>
      )}
    </div>
    <figure class="ma-photo photo-frame-3d">
      <img src="/images/Teton1.webp" alt={home.why.card.photoAlt} width="1672" height="941" loading="lazy" decoding="async" />
      <figcaption><strong>{home.why.card.name}</strong><span>{home.why.card.role}</span></figcaption>
    </figure>
  </div>
</section>

<!-- Benefits as cards -->
<section class="ma-section ma-benefits">
  <div class="container">
    <span class="ma-eyebrow">{c.includes.benefitsEyebrow}</span>
    <h2>{c.includes.benefitsH3}</h2>
    <ul class="ma-benefit-grid">
      {c.includes.benefitsHtml.map((item, i) => (
        <li class="ma-benefit">
          <span class="ma-benefit-icon" set:html={benefitIcons[i % benefitIcons.length]} />
          <p set:html={item.replace(/<\/strong>\s*(&mdash;|—)\s*/, '</strong>')} />
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Networks: photo left, HMO / PPO right -->
<section class="ma-section ma-networks">
  <div class="container ma-split ma-split--photo-left">
    <figure class="ma-photo ma-photo--landscape photo-frame-3d photo-frame-3d--tilt-right">
      <img src="/images/teton-mobile.webp" alt="" width="1000" height="563" loading="lazy" decoding="async" />
      <span class="ma-photo-badge" set:html={icons.people} />
    </figure>
    <div>
      <span class="ma-eyebrow">{c.includes.networksEyebrow}</span>
      <h2>{c.includes.networksH3}</h2>
      <p class="ma-lead" set:html={netLead}></p>
      <div class="ma-network-types">
        {c.includes.networkTypes.map((n, i) => (
          <div class="ma-network">
            <span class="ma-network-icon" set:html={i === 0 ? icons.people : icons.swap} />
            <div><strong>{n.__name}</strong><p set:html={n.textHtml} /></div>
          </div>
        ))}
      </div>
      {netVerify && (
        <p class="ma-verify"><span set:html={icons.check} /><span set:html={netVerify} /></p>
      )}
    </div>
  </div>
</section>

<!-- Copays & MOOP: copy left, photo card with the MOOP sentence right -->
<section class="ma-section ma-moop">
  <div class="container ma-split">
    <div>
      <span class="ma-eyebrow">{c.includes.moopEyebrow}</span>
      <h2>{c.includes.moopH3}</h2>
      <p class="ma-lead" set:html={moopLead}></p>
    </div>
    <div class="ma-moop-card photo-frame-3d">
      <div class="ma-moop-box">
        <span class="ma-moop-icon" set:html={icons.dollar} />
        <p set:html={moopRest.length ? moopRest.join(' ') : moopLead}></p>
      </div>
    </div>
  </div>
</section>

<!-- Fit checklist + annual-review callout -->
<section class="ma-section ma-fit">
  <div class="container ma-split ma-split--fit">
    <div>
      <span class="ma-eyebrow">{c.fit.eyebrow}</span>
      <h2>{c.fit.h2}</h2>
      <p class="ma-lead">{c.fit.intro}</p>
      <ul class="ma-checklist">
        {c.fit.itemsHtml.map((item) => <li><span set:html={icons.check} /><span set:html={item} /></li>)}
      </ul>
      {notFit && (
        <div class="ma-notfit">
          <h3>{notFit.h2}</h3>
          <p>{notFit.intro}</p>
          <ul>
            {notFit.itemsHtml.map((item) => <li set:html={item} />)}
          </ul>
        </div>
      )}
    </div>
    <aside class="ma-fit-callout">
      <span class="ma-fit-icon" set:html={icons.people} />
      <strong>{c.callout.heading}</strong>
      <p set:html={c.callout.textHtml}></p>
      <a href={localizeHref('contact.html', lang)} class="ma-btn-primary">{c.cta.scheduleLabel}<span set:html={icons.arrow} /></a>
    </aside>
  </div>
</section>

<!-- Utah resources as cards -->
<section class="ma-section ma-related">
  <div class="container">
    <span class="ma-eyebrow">{c.related.eyebrow}</span>
    <h2>{utahH2}</h2>
    <div class="ma-related-grid">
      <a class="ma-related-card" href={utahHubLink.href}><span class="ma-related-icon" set:html={icons.pin} /><span>{utahHubLink.label}</span></a>
      <a class="ma-related-card" href={utahMaLink.href}><span class="ma-related-icon" set:html={icons.shield} /><span set:html={utahMaLink.labelHtml} /></a>
      {countyLinks.map((l) => (
        <a class="ma-related-card" href={l.href}><span class="ma-related-icon" set:html={icons.pin} /><span>{l.label}</span></a>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="ma-cta">
  <div class="container">
    <div>
      <span class="ma-eyebrow ma-eyebrow--light">{c.cta.eyebrow}</span>
      <h2 set:html={c.cta.h2Html}></h2>
      <p set:html={c.cta.textHtml}></p>
    </div>
    <div class="ma-cta-actions">
      <a href={localizeHref('contact.html', lang)} class="ma-btn-gold">{c.cta.scheduleLabel}<span set:html={icons.arrow} /></a>
      <a href="tel:4352925548" class="ma-cta-phone"><span set:html={icons.phone} />{interp(c.cta.callLabel, vars)}</a>
      <a href={COMPARE_PLANS_URL} target="_blank" rel="noopener" class="ma-cta-compare">{c.cta.compareLabel}<span set:html={icons.arrow} /></a>
    </div>
  </div>
</section>

<div class="basics-tools">
<HelpfulTools />
</div>

</MainLayout>
