---
// County Medicare Advantage section (Phase 6). ONE component renders the local
// block on every county MA page; the counties differ only through the data in
// src/data/countyMedicareAdvantage.ts. Renders nothing when a place has no
// county MA data (e.g. the statewide /utah/medicare-advantage page), so adding
// or removing a county is a data change, not a template change.
//
// Claim discipline is enforced structurally here, not by an author remembering:
// the component can only render brand names and plan types, so there is no code
// path that emits a contract count, a provider or network claim, a plan-level
// figure, or a year-over-year churn statement. See the rules block in
// src/data/countyMedicareAdvantage.ts before changing anything below.
import type { Place } from '../../data/places';
import { getCountyMa, maPeriod, MA_SOURCE_URL } from '../../data/countyMedicareAdvantage';
import type { LocationPageCopy } from '../../data/places';
import { PLACES, pageHref } from '../../data/places';
import { interp, localizeHref } from '../../i18n/content';
import { getLangFromUrl } from '../../i18n/locales';

interface Props {
  place: Place;
  /** The `advantage` copy object for the active locale. */
  copy: LocationPageCopy;
  /** Interpolation vars from the host page (placeName, phone, …). */
  vars: Record<string, string | number>;
}
const { place, copy, vars } = Astro.props;
const data = getCountyMa(place);

const lang = getLangFromUrl(Astro.url);
const angles = (copy.cmaAngles as { slug: string; text: string }[] | undefined) ?? [];
const angle = angles.find((a) => a.slug === place.slug)?.text;
// Upward link to the statewide MA pillar (Phase 7). The county pages had no
// path back up to /utah/medicare-advantage, which left that pillar with only 2
// contextual inbound links against 6-7 for its Medigap and Part D siblings.
const stateOf = PLACES.find((p) => p.kind === 'state' && place.slug.startsWith(`${p.slug}/`));
const v = {
  ...vars,
  maPeriod: maPeriod(lang),
  maSourceUrl: MA_SOURCE_URL,
  stateName: stateOf?.name ?? '',
  stateMaHref: stateOf ? localizeHref(pageHref(stateOf, 'medicare-advantage'), lang) : '',
};
---

{data && (
  <section class="section-tinted">
    <div class="container content-narrow">
      <h2>{interp(copy.cmaH2 as string, v)}</h2>
      {angle && <p set:html={angle} />}

      <h3>{interp(copy.cmaBrandsH3 as string, v)}</h3>
      <p set:html={interp(copy.cmaBrandsIntroHtml as string, v)} />
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">{interp(copy.cmaColBrand as string, v)}</th>
              <th scope="col">{interp(copy.cmaColPlanTypes as string, v)}</th>
            </tr>
          </thead>
          <tbody>
            {data.brands.map((b) => (
              <tr>
                <th scope="row">{b.brand}</th>
                <td>{b.planTypes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3>{interp(copy.cmaEnrollH3 as string, v)}</h3>
      <p set:html={interp(copy.cmaEnrollIntroHtml as string, v)} />
      <ul>
        {data.enrollment.map((e) => (
          <li>{e.brand} &mdash; {e.share.toFixed(1)}%</li>
        ))}
      </ul>

      <p set:html={interp(copy.cmaCaveatHtml as string, v)} />
      {stateOf && <p set:html={interp(copy.cmaUpLinkHtml as string, v)} />}
      <p class="source-note"><small set:html={interp(copy.cmaSourceHtml as string, v)} /></p>
    </div>
  </section>
)}

<style>
  /* Wide content must scroll inside its own container, never the page body. */
  .table-scroll { overflow-x: auto; margin: 1rem 0; }
  .table-scroll table { width: 100%; border-collapse: collapse; }
  .table-scroll th, .table-scroll td {
    text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }
  .table-scroll thead th { font-weight: 600; white-space: nowrap; }
  .table-scroll tbody th { font-weight: 400; }
  .source-note { margin-top: 1rem; opacity: 0.8; }
</style>
